{
  "name": "@openthreads/storage-mongodb",
  "version": "0.1.0",
  "description": "MongoDB storage adapter for OpenThreads",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "test:integration": "TEST_MONGODB_URI=mongodb://localhost:27017/openthreads_test bun test tests/integration/"
  },
  "dependencies": {
    "@openthreads/core": "workspace:*",
    "mongodb": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0"
  }
}
